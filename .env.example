# Gemini API 키를 = 뒤에 붙여넣으세요. (따옴표/공백 없이, 공유·커밋 금지)
GEMINI_API_KEY=
# 모델을 바꾸려면 주석을 풀고 수정하세요. (기본값: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# 상황형 질문의 검색 후보를 Gemini로 한 번 더 판정해 관련 없는 정책을 접는다(기본 켜짐, 검색마다 Gemini 호출 +1회).
# 끄려면 아래 줄의 주석을 풀고 0으로 둔다. 판정이 실패하면 자동으로 거리 기반 결과를 쓴다.
# WELFAREONE_LLM_RERANK=0
