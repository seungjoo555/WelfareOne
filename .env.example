# Gemini API 키를 = 뒤에 붙여넣으세요. (따옴표/공백 없이, 공유·커밋 금지)
GEMINI_API_KEY=
# 모델을 바꾸려면 주석을 풀고 수정하세요. (기본값: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# 상황형 질문의 검색 후보를 Gemini로 한 번 더 판정해 관련 없는 정책을 접는다(기본 켜짐, 검색마다 Gemini 호출 +1회).
# 끄려면 아래 줄의 주석을 풀고 0으로 둔다. 판정이 실패하면 자동으로 거리 기반 결과를 쓴다.
# WELFAREONE_LLM_RERANK=0

# 리랭커(BAAI/bge-reranker-v2-m3, 로컬 캐시 필요)로 상황형 질문 후보를 재정렬한다. 끄려면 0. 모델이 없으면 자동으로 꺼진다.
# WELFAREONE_RERANKER=0

# ── 서버 기본 LLM(Qwen 등 OpenAI 호환 서버: LM Studio, Ollama, vLLM) ─────────────────────────
# 설정하면 사용자가 키를 넣지 않은 요청은 이 모델이 처리한다. 사용자가 본인 Gemini 키를 보내면 항상 Gemini가 처리한다.
# 비워 두면 기존 동작(키 없음 → 401 또는 WELFAREONE_ALLOW_SERVER_KEY 폴백)과 같다.
# LLM_PROVIDER=qwen
# QWEN_BASE_URL=http://localhost:1234/v1
# QWEN_MODEL=qwen/qwen3-4b-2507
# QWEN_API_KEY=
# QWEN_TIMEOUT_S=60
# 추론 모델의 생각 모드를 끄는 값이 기본으로 들어간다({"reasoning_effort": "none"}). 바꾸려면 JSON으로 지정한다.
# QWEN_EXTRA_BODY={"reasoning_effort": "none"}
